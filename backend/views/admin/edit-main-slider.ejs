<div class="page-content">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
          <h4 class="mb-sm-0">Edit Main Slider</h4>
          <div class="page-title-right">
            <ol class="breadcrumb m-0">
              <li class="breadcrumb-item"><a href="/main-slider">Main Slider</a></li>
              <li class="breadcrumb-item active">Edit</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <div class="row">
      <div class="col-lg-12">
        <div class="card">
          <div class="card-header">
            <h4 class="card-title mb-0">Edit Slider #<%= slider.id %></h4>
          </div>
          <div class="card-body">
            <form action="/main-slider/edit/<%= slider.id %>" method="POST" enctype="multipart/form-data">
              <div class="row g-3">
                
                <div class="col-lg-12">
                  <label class="form-label">Small Heading</label>
                  <input type="text" class="form-control" name="heading_small" value="<%= slider.heading_small %>">
                </div>
                
                <div class="col-lg-12">
                  <label class="form-label">Main Heading</label>
                  <input type="text" class="form-control" name="heading_main" value="<%= slider.heading_main %>">
                </div>
                
                <div class="col-lg-12">
                  <label class="form-label">Description</label>
                  <textarea class="form-control" name="description" rows="3"><%= slider.description %></textarea>
                </div>
                
                <div class="col-lg-6">
                  <label class="form-label">Button Text</label>
                  <input type="text" class="form-control" name="button_text" value="<%= slider.button_text %>">
                </div>
                <div class="col-lg-6">
                  <label class="form-label">Button Link</label>
                  <input type="text" class="form-control" name="button_link" value="<%= slider.button_link %>">
                </div>
                
                <div class="col-lg-6">
                  <label class="form-label">Large Image 
                    <% if(slider.image_large) { %><small class="text-success">(Current: <%= slider.image_large %>)</small><% } %>
                  </label>
                  <input type="file" class="form-control" name="large_image" accept="image/*">
                </div>
                <div class="col-lg-6">
                  <label class="form-label">Small Image 
                    <% if(slider.image_small) { %><small class="text-success">(Current: <%= slider.image_small %>)</small><% } %>
                  </label>
                  <input type="file" class="form-control" name="small_image" accept="image/*">
                </div>

                <div class="col-lg-6">
                  <label class="form-label">Sort Order</label>
                  <input type="number" class="form-control" name="sort_order" value="<%= slider.sort_order %>">
                </div>
                <div class="col-lg-6">
                  <label class="form-label">Status</label>
                  <select name="status" class="form-select">
                    <option value="Active" <%= slider.status === 1 ? 'selected' : '' %>>Active</option>
                    <option value="Inactive" <%= slider.status === 0 ? 'selected' : '' %>>Inactive</option>
                  </select>
                </div>

                <div class="col-lg-12 mt-4">
                  <button type="submit" class="btn btn-success">Update Slider</button>
                  <a href="/main-slider" class="btn btn-secondary ms-2">Cancel</a>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
