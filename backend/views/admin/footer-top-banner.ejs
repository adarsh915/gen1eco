<div class="row gy-4">
    <div class="col-xl-8 offset-xl-2">

        <!-- Alerts -->
        <% if (success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="ri-checkbox-circle-line me-2"></i> <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        <% if (error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="ri-error-warning-line me-2"></i> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Footer Top Two Banners</h5>
                <% if (banner) { %>
                    <form action="/footer-top-banner/delete" method="POST" class="d-inline"
                          onsubmit="return confirm('Are you sure you want to delete the banners?')">
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="ri-delete-bin-line me-1"></i> Delete
                        </button>
                    </form>
                <% } %>
            </div>
            <div class="card-body">
                <form action="/footer-top-banner/save" method="POST" enctype="multipart/form-data">

                    <!-- LEFT BANNER -->
                    <h5 class="mt-3 mb-3">Left Banner</h5>
                    <% if (banner && banner.left_banner_image) { %>
                        <div class="mb-2">
                            <img src="/uploads/footer_banners/<%= banner.left_banner_image %>"
                                 height="80" class="rounded border"
                                 alt="Left Banner">
                        </div>
                    <% } %>
                    <div class="mb-2">
                        <label class="form-label">Banner Image</label>
                        <input type="file" name="left_banner" class="form-control" accept="image/*">
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Title</label>
                        <input type="text" name="left_title" class="form-control"
                               placeholder="Title"
                               value="<%= banner ? banner.left_title : '' %>">
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Subtitle</label>
                        <input type="text" name="left_subtitle" class="form-control"
                               placeholder="Subtitle"
                               value="<%= banner ? banner.left_subtitle : '' %>">
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Button Text</label>
                        <input type="text" name="left_button_text" class="form-control"
                               placeholder="Button Text"
                               value="<%= banner ? banner.left_button_text : '' %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Button Link</label>
                        <input type="text" name="left_button_link" class="form-control"
                               placeholder="Button Link"
                               value="<%= banner ? banner.left_button_link : '' %>">
                    </div>

                    <hr>

                    <!-- RIGHT BANNER -->
                    <h5 class="mt-3 mb-3">Right Banner</h5>
                    <% if (banner && banner.right_banner_image) { %>
                        <div class="mb-2">
                            <img src="/uploads/footer_banners/<%= banner.right_banner_image %>"
                                 height="80" class="rounded border"
                                 alt="Right Banner">
                        </div>
                    <% } %>
                    <div class="mb-2">
                        <label class="form-label">Banner Image</label>
                        <input type="file" name="right_banner" class="form-control" accept="image/*">
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Title</label>
                        <input type="text" name="right_title" class="form-control"
                               placeholder="Title"
                               value="<%= banner ? banner.right_title : '' %>">
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Subtitle</label>
                        <input type="text" name="right_subtitle" class="form-control"
                               placeholder="Subtitle"
                               value="<%= banner ? banner.right_subtitle : '' %>">
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Button Text</label>
                        <input type="text" name="right_button_text" class="form-control"
                               placeholder="Button Text"
                               value="<%= banner ? banner.right_button_text : '' %>">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Button Link</label>
                        <input type="text" name="right_button_link" class="form-control"
                               placeholder="Button Link"
                               value="<%= banner ? banner.right_button_link : '' %>">
                    </div>

                    <hr>

                    <!-- STATUS -->
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-control">
                            <option value="1" <%= banner && banner.status == 1 ? 'selected' : '' %>>Active</option>
                            <option value="0" <%= banner && banner.status == 0 ? 'selected' : '' %>>Inactive</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-success">
                        <i class="ri-save-line me-1"></i>
                        <%= banner ? 'Update Banners' : 'Save Banners' %>
                    </button>

                </form>
            </div>
        </div>

    </div>
</div>