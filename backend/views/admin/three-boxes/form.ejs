<div class="row gy-4">
    <div class="col-xl-8 offset-xl-2">

        <!-- Alerts -->
        <% if (error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="ri-error-warning-line me-2"></i> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0"><%= box ? 'Edit Box' : 'Add New Box' %></h5>
                <a href="/three-boxes" class="btn btn-secondary btn-sm">
                    <i class="ri-arrow-left-line me-1"></i> Back to List
                </a>
            </div>
            <div class="card-body">
                <form action="/three-boxes/<%= box ? 'update' : 'create' %>"
                      method="POST" enctype="multipart/form-data">

                    <% if (box) { %>
                        <input type="hidden" name="id" value="<%= box.id %>">
                    <% } %>

                    <!-- Image -->
                    <div class="mb-3">
                        <label class="form-label">Box Image</label>
                        <% if (box && box.image) { %>
                            <div class="mb-2">
                                <img src="/uploads/three-boxes/<%= box.image %>"
                                     width="120" class="rounded border" alt="Box Image">
                            </div>
                            <small class="text-muted d-block mb-2">Leave empty to keep current image.</small>
                        <% } %>
                        <input type="file" name="image" class="form-control" accept="image/*"
                               <%= box ? '' : 'required' %>>
                    </div>

                    <!-- Heading -->
                    <div class="mb-3">
                        <label class="form-label">Heading</label>
                        <input type="text" name="heading" class="form-control"
                               placeholder="Heading"
                               value="<%= box ? box.heading : '' %>" required>
                    </div>

                    <!-- Sub Heading -->
                    <div class="mb-3">
                        <label class="form-label">Sub Heading</label>
                        <input type="text" name="sub_heading" class="form-control"
                               placeholder="Sub Heading"
                               value="<%= box ? box.sub_heading : '' %>">
                    </div>

                    <!-- Button Text -->
                    <div class="mb-3">
                        <label class="form-label">Button Text</label>
                        <input type="text" name="button_text" class="form-control"
                               placeholder="Button Text"
                               value="<%= box ? box.button_text : '' %>">
                    </div>

                    <!-- Button Link -->
                    <div class="mb-3">
                        <label class="form-label">Button Link</label>
                        <input type="text" name="button_link" class="form-control"
                               placeholder="Button Link"
                               value="<%= box ? box.button_link : '' %>">
                    </div>

                    <!-- Status -->
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-control">
                            <option value="1" <%= box && box.status == 1 ? 'selected' : '' %>>Active</option>
                            <option value="0" <%= box && box.status == 0 ? 'selected' : '' %>>Inactive</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-success">
                        <i class="ri-save-line me-1"></i>
                        <%= box ? 'Update Box' : 'Create Box' %>
                    </button>

                </form>
            </div>
        </div>

    </div>
</div>