<div class="row gy-4">
    <div class="col-12">

        <!-- Alerts -->
        <% if (success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="ri-checkbox-circle-line me-2"></i> <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        <% if (error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="ri-error-warning-line me-2"></i> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between mb-3">
            <span class="badge bg-primary-100 text-primary-600">
                Total Orders: <%= orders.length %>
            </span>
        </div>

        <!-- Filters -->
        <div class="card mb-4">
            <div class="card-body">
                <form action="/orders" method="GET">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            <select name="status" class="form-select">
                                <option value="">All Status</option>
                                <% statuses.forEach(function(s) { %>
                                    <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>>
                                        <%= s %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">From Date</label>
                            <input type="date" name="from_date" class="form-control"
                                   value="<%= filters.from_date %>">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">To Date</label>
                            <input type="date" name="to_date" class="form-control"
                                   value="<%= filters.to_date %>">
                        </div>
                        <div class="col-md-3 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="ri-filter-line me-1"></i> Filter
                            </button>
                            <a href="/orders" class="btn btn-secondary">
                                <i class="ri-refresh-line me-1"></i> Reset
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Table -->
        <div class="card basic-data-table">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table bordered-table mb-0" id="dataTable" data-page-length="10" style="min-width:900px;">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Order No</th>
                                <th>User</th>
                                <th>Total</th>
                                <th class="d-none d-md-table-cell">Payment</th>
                                <th>Status</th>
                                <th class="d-none d-md-table-cell">Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (orders && orders.length > 0) { %>
                                <% orders.forEach(function(order, index) { %>
                                    <%
                                        const statusColors = {
                                            PENDING:    'bg-warning-focus text-warning-main',
                                            CONFIRMED:  'bg-primary-light text-primary-600',
                                            PROCESSING: 'bg-info-focus text-info-main',
                                            SHIPPED:    'bg-primary-light text-primary-600',
                                            DELIVERED:  'bg-success-focus text-success-main',
                                            CANCELLED:  'bg-danger-focus text-danger-main',
                                            RETURNED:   'bg-danger-focus text-danger-main'
                                        };
                                        const colorClass = statusColors[order.order_status] || 'bg-secondary text-white';
                                    %>
                                    <tr>
                                        <td><%= index + 1 %></td>
                                        <td>
                                            <span class="fw-medium text-primary-600">
                                                <%= order.order_number %>
                                            </span>
                                        </td>
                                        <td><span class="fw-medium"><%= order.user_name || '—' %></span></td>
                                        <td>
                                            <span class="fw-semibold">
                                                ₹<%= parseFloat(order.total_amount).toFixed(2) %>
                                            </span>
                                        </td>
                                        <td class="d-none d-md-table-cell">
                                            <span class="badge bg-primary-100 text-primary-600">
                                                <%= order.payment_method %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge <%= colorClass %> px-2 py-1">
                                                <%= order.order_status %>
                                            </span>
                                        </td>
                                        <td class="d-none d-md-table-cell">
                                            <%
                                                const d = new Date(order.created_at);
                                                const formatted = d.toLocaleDateString('en-GB', {
                                                    day: '2-digit', month: 'short', year: 'numeric'
                                                });
                                            %>
                                            <%= formatted %>
                                        </td>
                                        <td>
                                            <a href="/orders/view/<%= order.id %>"
                                               class="w-32-px h-32-px bg-primary-light text-primary-600 rounded-circle d-inline-flex align-items-center justify-content-center border-0"
                                               title="View">
                                                <iconify-icon icon="iconamoon:eye-light"></iconify-icon>
                                            </a>
                                            <form action="/orders/delete/<%= order.id %>" method="POST" class="d-inline"
                                                  onsubmit="return confirm('Delete this order?')">
                                                <button type="submit"
                                                        class="w-32-px h-32-px bg-danger-focus text-danger-main rounded-circle d-inline-flex align-items-center justify-content-center border-0"
                                                        title="Delete">
                                                    <iconify-icon icon="mingcute:delete-2-line"></iconify-icon>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-4">
                                        <i class="ri-shopping-bag-line fs-3 d-block mb-2"></i>
                                        No orders found.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

<% script = `
<script>
    (function () { if (typeof DataTable !== 'undefined' && document.querySelector('#dataTable')) { new DataTable('#dataTable'); } })();
</script>
` %>