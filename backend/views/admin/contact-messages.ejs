<div class="row gy-4">
    <div class="col-12">

        <!-- Alerts -->
        <% if (success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="ri-checkbox-circle-line me-2"></i>
                <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% } %>
                <% if (error) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="ri-error-warning-line me-2"></i>
                        <%= error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <% } %>

                        <!-- Table Card -->
                        <div class="card basic-data-table">
                            <div class="card-header d-flex align-items-center justify-content-between">
                                <h5 class="card-title mb-0">Contact Messages</h5>
                                <span class="badge bg-primary-100 text-primary-600">
                                    Total: <%= messages.length %>
                                </span>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table bordered-table mb-0" id="dataTable" data-page-length="10"
                                        style="min-width: 900px;">
                                        <thead>
                                            <tr>
                                                <th style="width:40px">#</th>
                                                <th style="width:120px">Name</th>
                                                <th class="d-none d-md-table-cell" style="width:180px">Email</th>
                                                <th class="d-none d-lg-table-cell" style="width:120px">Phone</th>
                                                <th style="width:150px">Subject</th>
                                                <th class="d-none d-lg-table-cell" style="width:180px">Message</th>
                                                <th class="d-none d-md-table-cell" style="width:110px">Received At</th>
                                                <th style="width:90px">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (messages && messages.length> 0) { %>
                                                <% messages.forEach(function(msg, index) { %>
                                                    <tr>
                                                        <td>
                                                            <%= index + 1 %>
                                                        </td>
                                                        <td><span class="fw-medium">
                                                                <%= msg.name %>
                                                            </span></td>
                                                        <td class="d-none d-md-table-cell">
                                                            <a href="mailto:<%= msg.email %>" class="text-primary-600">
                                                                <%= msg.email %>
                                                            </a>
                                                        </td>
                                                        <td class="d-none d-lg-table-cell">
                                                            <%= msg.phone || '—' %>
                                                        </td>
                                                        <td>
                                                            <%= msg.subject %>
                                                        </td>
                                                        <td class="d-none d-lg-table-cell">
                                                            <span data-bs-toggle="tooltip" data-bs-placement="top"
                                                                title="<%= msg.message %>" style="cursor:pointer;">
                                                                <%= msg.message.length> 40
                                                                    ? msg.message.substring(0, 40) + '...'
                                                                    : msg.message %>
                                                            </span>
                                                        </td>
                                                        <td class="d-none d-md-table-cell">
                                                            <% const d=new Date(msg.created_at); const
                                                                formatted=d.toLocaleDateString('en-GB', { day: '2-digit'
                                                                , month: 'short' , year: 'numeric' }); %>
                                                                <%= formatted %>
                                                        </td>
                                                        <td>
                                                            <button type="button"
                                                                class="w-32-px h-32-px bg-primary-light text-primary-600 rounded-circle d-inline-flex align-items-center justify-content-center border-0"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#viewModal<%= msg.id %>" title="View">
                                                                <iconify-icon icon="iconamoon:eye-light"></iconify-icon>
                                                            </button>
                                                            <button type="button"
                                                                class="w-32-px h-32-px bg-danger-focus text-danger-main rounded-circle d-inline-flex align-items-center justify-content-center border-0"
                                                                onclick="confirmDelete(<%= msg.id %>)" title="Delete">
                                                                <iconify-icon
                                                                    icon="mingcute:delete-2-line"></iconify-icon>
                                                            </button>
                                                            <form id="deleteForm<%= msg.id %>"
                                                                action="/contact-messages/<%= msg.id %>/delete"
                                                                method="POST" style="display:none;">
                                                            </form>
                                                        </td>
                                                    </tr>

                                                    <!-- View Modal -->
                                                    <div class="modal fade" id="viewModal<%= msg.id %>" tabindex="-1"
                                                        aria-hidden="true">
                                                        <div class="modal-dialog modal-dialog-centered">
                                                            <div class="modal-content">
                                                                <div class="modal-header">
                                                                    <h5 class="modal-title">
                                                                        <i
                                                                            class="ri-mail-line me-2 text-primary-600"></i>
                                                                        Message from <%= msg.name %>
                                                                    </h5>
                                                                    <button type="button" class="btn-close"
                                                                        data-bs-dismiss="modal"></button>
                                                                </div>
                                                                <div class="modal-body">
                                                                    <div class="mb-2">
                                                                        <span
                                                                            class="text-muted fw-semibold">Name:</span>
                                                                        <span class="ms-2">
                                                                            <%= msg.name %>
                                                                        </span>
                                                                    </div>
                                                                    <div class="mb-2">
                                                                        <span
                                                                            class="text-muted fw-semibold">Email:</span>
                                                                        <a href="mailto:<%= msg.email %>"
                                                                            class="ms-2 text-primary-600">
                                                                            <%= msg.email %>
                                                                        </a>
                                                                    </div>
                                                                    <div class="mb-2">
                                                                        <span
                                                                            class="text-muted fw-semibold">Phone:</span>
                                                                        <span class="ms-2">
                                                                            <%= msg.phone || '—' %>
                                                                        </span>
                                                                    </div>
                                                                    <div class="mb-2">
                                                                        <span
                                                                            class="text-muted fw-semibold">Subject:</span>
                                                                        <span class="ms-2">
                                                                            <%= msg.subject %>
                                                                        </span>
                                                                    </div>
                                                                    <div class="mb-2">
                                                                        <span
                                                                            class="text-muted fw-semibold">Received:</span>
                                                                        <span class="ms-2">
                                                                            <%= new
                                                                                Date(msg.created_at).toLocaleString('en-GB')
                                                                                %>
                                                                        </span>
                                                                    </div>
                                                                    <hr>
                                                                    <p class="fw-semibold text-muted mb-1">Message:</p>
                                                                    <p class="text-muted">
                                                                        <%= msg.message %>
                                                                    </p>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary"
                                                                        data-bs-dismiss="modal">Close</button>
                                                                    <button type="button" class="btn btn-danger"
                                                                        data-bs-dismiss="modal"
                                                                        onclick="confirmDelete(<%= msg.id %>)">
                                                                        Delete
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <% }); %>
                                                        <% } else { %>
                                                            <tr>
                                                                <td colspan="8" class="text-center text-muted py-4">
                                                                    <i class="ri-inbox-line fs-3 d-block mb-2"></i>
                                                                    No contact messages found.
                                                                </td>
                                                            </tr>
                                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
    </div>

</div>
</div>

<% /* ✅ Same pattern as your working datatable pages */ %>
    <% script=` <script>
        (function () { if (typeof DataTable !== 'undefined' && document.querySelector('#dataTable')) { new DataTable('#dataTable'); } })();

        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => {
        new bootstrap.Tooltip(el);
        });

        function confirmDelete(id) {
        if (confirm('Are you sure you want to delete this message? This cannot be undone.')) {
        document.getElementById('deleteForm' + id).submit();
        }
        }
        </script>
        ` %>