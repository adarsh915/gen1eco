<div class="row gy-4">
    <div class="col-xl-10 offset-xl-1">

        <% if (error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="ri-error-warning-line me-2"></i>
                <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            <% } %>

                <div class="card">
                    <div class="card-header d-flex align-items-center justify-content-between">
                        <h5 class="mb-0">
                            <%= product ? 'Edit Product' : 'Add New Product' %>
                        </h5>
                        <a href="/products" class="btn btn-secondary btn-sm">
                            <i class="ri-arrow-left-line me-1"></i> Back
                        </a>
                    </div>
                    <div class="card-body">
                        <form action="/products/<%= product ? 'update' : 'create' %>" method="POST"
                            enctype="multipart/form-data">

                            <% if (product) { %>
                                <input type="hidden" name="id" value="<%= product.id %>">
                                <% } %>

                                    <div class="row g-3">

                                        <!-- Product Name -->
                                        <div class="col-md-8">
                                            <label class="form-label">Product Name <span
                                                    class="text-danger">*</span></label>
                                            <input type="text" name="product_name" class="form-control"
                                                placeholder="Product Name"
                                                value="<%= product ? product.product_name : '' %>" required>
                                        </div>

                                        <!-- Status -->
                                        <div class="col-md-4">
                                            <label class="form-label">Status</label>
                                            <select name="status" class="form-select">
                                                <option value="1" <%=product && product.status==1 ? 'selected' : '' %>
                                                    >Active</option>
                                                <option value="0" <%=product && product.status==0 ? 'selected' : '' %>
                                                    >Inactive</option>
                                            </select>
                                        </div>

                                        <!-- Category Mappings -->
                                        <div class="col-12">
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <label class="form-label mb-0">Category Mappings <span class="text-danger">*</span></label>
                                                <button type="button" id="add-category-mapping" class="btn btn-outline-primary btn-sm">
                                                    <i class="ri-add-line me-1"></i> Add Category
                                                </button>
                                            </div>
                                            <div id="category-mapping-container" class="d-flex flex-column gap-2"></div>
                                            <small class="text-muted">The first mapping is treated as the primary category for legacy fields.</small>
                                        </div>

                                        <!-- Price -->
                                        <div class="col-md-4">
                                            <label class="form-label">Price <span class="text-danger">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text">₹</span>
                                                <input type="number" step="0.01" name="price" class="form-control"
                                                    placeholder="0.00" value="<%= product ? product.price : '' %>"
                                                    required>
                                            </div>
                                        </div>

                                        <!-- Sale Price -->
                                        <div class="col-md-4">
                                            <label class="form-label">Sale Price</label>
                                            <div class="input-group">
                                                <span class="input-group-text">₹</span>
                                                <input type="number" step="0.01" name="sale_price" class="form-control"
                                                    placeholder="0.00" value="<%= product ? product.sale_price : '' %>">
                                            </div>
                                        </div>

                                        <!-- Stock -->
                                        <div class="col-md-4">
                                            <label class="form-label">Stock</label>
                                            <input type="number" name="stock" class="form-control" placeholder="0"
                                                value="<%= product ? product.stock : '' %>">
                                        </div>

                                        <!-- Default Variant Info -->
                                        <div class="col-md-4">
                                            <label class="form-label">Default Variant Name</label>
                                            <input type="text" name="default_variant_name" class="form-control" 
                                                   placeholder="e.g. Size, Format" value="<%= product ? (product.default_variant_name || 'Standard') : 'Standard' %>">
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Default Variant Value</label>
                                            <input type="text" name="default_variant_value" class="form-control" 
                                                   placeholder="e.g. 500ml, 1kg" value="<%= product ? (product.default_variant_value || 'Regular') : 'Regular' %>">
                                        </div>

                                        <!-- GST Selection -->
                                        <div class="col-md-4">
                                            <label class="form-label">GST Rate</label>
                                            <select name="gst_id" class="form-select">
                                                <option value="" <%= (!product || product.gst_id === null) ? 'selected' : '' %>>-- No GST --</option>
                                                <% gstList.forEach(function(gst) { %>
                                                    <option value="<%= gst.id %>" <%= product && Number(product.gst_id) === Number(gst.id) ? 'selected' : '' %>>
                                                        <%= gst.gst_title %> (<%= gst.gst_percent %>%)
                                                    </option>
                                                <% }); %>
                                            </select>
                                        </div>

                                        <!-- Discount Percentage -->
                                        <div class="col-md-4">
                                            <label class="form-label">Discount (%)</label>
                                            <div class="input-group">
                                                <input type="number" step="0.01" name="discount_percent" class="form-control"
                                                    placeholder="0.00" value="<%= product ? product.discount_percent : '0' %>">
                                                <span class="input-group-text">%</span>
                                            </div>
                                        </div>

                                        <!-- Categorization Flags -->
                                        <div class="col-md-12">
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="form-check form-switch mt-2">
                                                        <input class="form-check-input" type="checkbox" name="is_featured" id="isFeatured" <%= product && product.is_featured ? 'checked' : '' %>>
                                                        <label class="form-check-label fw-bold" for="isFeatured">Featured Product</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-check form-switch mt-2">
                                                        <input class="form-check-input" type="checkbox" name="is_best_selling" id="isBestSelling" <%= product && product.is_best_selling ? 'checked' : '' %>>
                                                        <label class="form-check-label fw-bold" for="isBestSelling">Best Selling Product</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="form-check form-switch mt-2">
                                                        <input class="form-check-input" type="checkbox" name="is_new_arrival" id="isNewArrival" <%= product && product.is_new_arrival ? 'checked' : '' %>>
                                                        <label class="form-check-label fw-bold" for="isNewArrival">New Arrival Product</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Product Image -->
                                        <div class="col-md-6">
                                            <label class="form-label">Product Image</label>
                                            <% if (product && product.product_image) { %>
                                                <div class="mb-2">
                                                    <img src="/uploads/products/<%= product.product_image %>"
                                                        width="100" class="rounded border" alt="Product">
                                                </div>
                                                <small class="text-muted d-block mb-2">Leave empty to keep current
                                                    image.</small>
                                                <% } %>
                                                    <input type="file" name="product_image" class="form-control"
                                                        accept="image/*" <%=product ? '' : 'required' %>>
                                        </div>

                                        <!-- Product Video -->
                                        <div class="col-md-6">
                                            <label class="form-label">Product Video (File Upload)</label>
                                            <% if (product && product.video_url) { %>
                                                <div class="mb-2">
                                                    <span class="badge bg-secondary">Current Video: <%= product.video_url %></span>
                                                </div>
                                                <small class="text-muted d-block mb-2">Leave empty to keep current video.</small>
                                            <% } %>
                                            <input type="file" name="product_video" class="form-control" accept="video/*">
                                            <small class="text-muted">Choose a local video file (MP4/WebM).</small>
                                        </div>

                                        <!-- Short Description -->
                                        <div class="col-12">
                                            <label class="form-label">Short Description</label>
                                            <textarea name="short_description" id="short_description"
                                                class="form-control" rows="2"
                                                placeholder="Short Description"><%= product ? product.short_description : '' %></textarea>
                                        </div>

                                        <!-- Description -->
                                        <div class="col-12">
                                            <label class="form-label">Description</label>
                                            <textarea name="description" id="description" class="form-control" rows="5"
                                                placeholder="Full Description"><%= product ? product.description : '' %></textarea>
                                        </div>

                                        <div class="col-12">
                                            <button type="submit" class="btn btn-success">
                                                <i class="ri-save-line me-1"></i>
                                                <%= product ? 'Update Product' : 'Create Product' %>
                                            </button>
                                        </div>

                                    </div>
                        </form>
                    </div>
                </div>
    </div>
</div>
<script>
    window._formCategories = <%- JSON.stringify(categories) %>;
    window._formProduct = <%- (typeof product !== 'undefined' && product) ? JSON.stringify(product) : 'null' %>;
</script>
<% script = '<link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.20/summernote-lite.min.css" rel="stylesheet"><script src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.20/summernote-lite.min.js"><\/script><script src="/js/product-form.js"><\/script>'; %>
