<div class="page-content">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
          <h4 class="mb-sm-0">Add Main Slider</h4>
          <div class="page-title-right">
            <ol class="breadcrumb m-0">
              <li class="breadcrumb-item"><a href="javascript: void(0);">Settings</a></li>
              <li class="breadcrumb-item"><a href="/main-slider">Main Slider</a></li>
              <li class="breadcrumb-item active">Add Slider</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger text-danger bg-danger-100 border-danger-200">
        <%= error %>
      </div>
    <% } %>

    <div class="row">
      <div class="col-lg-12">
        <div class="card">
          <div class="card-header">
            <h4 class="card-title mb-0">Slider Information</h4>
          </div>
          <div class="card-body">
            <form action="/main-slider/add" method="POST" enctype="multipart/form-data">
              <div class="row g-3">
                
                <div class="col-lg-12">
                  <label class="form-label">Small Heading</label>
                  <input type="text" class="form-control" name="heading_small" placeholder="e.g. Sunrise Industries">
                </div>
                
                <div class="col-lg-12">
                  <label class="form-label">Main Heading</label>
                  <input type="text" class="form-control" name="heading_main" placeholder="e.g. Deep Clean Detergent">
                </div>
                
                <div class="col-lg-12">
                  <label class="form-label">Description</label>
                  <textarea class="form-control" name="description" rows="3" placeholder="Enter description..."></textarea>
                </div>
                
                <div class="col-lg-6">
                  <label class="form-label">Button Text</label>
                  <input type="text" class="form-control" name="button_text" placeholder="e.g. Shop Now">
                </div>
                <div class="col-lg-6">
                  <label class="form-label">Button Link</label>
                  <input type="text" class="form-control" name="button_link" placeholder="e.g. # or /products">
                </div>
                
                <div class="col-lg-6">
                  <label class="form-label">Large Image</label>
                  <input type="file" class="form-control" name="large_image" accept="image/*" required>
                </div>
                <div class="col-lg-6">
                  <label class="form-label">Small Image</label>
                  <input type="file" class="form-control" name="small_image" accept="image/*" required>
                </div>

                <div class="col-lg-6">
                  <label class="form-label">Sort Order</label>
                  <input type="number" class="form-control" name="sort_order" value="0">
                </div>
                <div class="col-lg-6">
                  <label class="form-label">Status</label>
                  <select name="status" class="form-select">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                  </select>
                </div>

                <div class="col-lg-12 mt-4">
                  <button type="submit" class="btn btn-primary">Save Slider</button>
                  <a href="/main-slider" class="btn btn-secondary">Cancel</a>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
